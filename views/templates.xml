<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="payment_webxpay_button" inherit_id="website_sale.payment">
        <xpath expr="//div[@id='payment_method']" position="inside">
            <div class="webxpay-button-container">
                <button id="webxpay_redirect_button" class="btn btn-primary">
                    Pay with WebXPay
                </button>
            </div>
        </xpath>
    </template>
</odoo>
